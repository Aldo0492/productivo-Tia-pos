{
  "manifest_version": 3,
  "name": "IA POS Flotante",
  "version": "3.1",
  "description": "Asistente IA conectado a n8n + publicidad dinamica + bloqueo tactil (unificado)",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tia-pos.js"
      ],
      "css": [
        "sidebar.css",
        "sidecar-ads.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8000/sidecarscreen/*"
      ],
      "js": [
        "touch-control.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "TIA.png",
        "be_you.png",
        "campeon_pass.png",
        "and_friends.png",
        "config.json",
        "restaurante.json",
        "fondo_restaurante.webp",
        "placas/*.webp"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}